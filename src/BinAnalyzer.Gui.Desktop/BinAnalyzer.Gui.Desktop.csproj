<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>BinAnalyzer.Gui.Desktop</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <!-- Photino.Blazor 4.0.x は net8/net9 向けパッケージだが net10 でも動作する（REQ-168 スパイクで確認） -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BinAnalyzer.Gui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.*" />
    <!-- 推移的な 9.x を RCL と同じ 10.x に揃える -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.*-*" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinAnalyzer.Gui\BinAnalyzer.Gui.csproj" />
    <ProjectReference Include="..\BinAnalyzer.Dsl\BinAnalyzer.Dsl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- blazor.webview.js は WebView パッケージの静的資産。通常は static web assets マニフェント経由で配信されるが、
         カスタム IFileProvider を使うため埋め込みリソースとして同梱する -->
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.webview.js" LogicalName="_framework/blazor.webview.js" />
    <!-- blazor.webview.js が起動時に取得する JS 初期化子マニフェスト（本アプリには初期化子が無いので空配列）。
         wwwroot 配下に置くと StaticWebAssets SDK が生成する同名資産と衝突するため Assets/ に置く -->
    <EmbeddedResource Include="Assets\empty-modules.json" LogicalName="_framework/blazor.modules.json" />
    <!-- 埋め込み専用。出力ディレクトリへ物理コピーしない -->
    <Content Remove="Assets\**" />
    <None Remove="Assets\**" />
  </ItemGroup>

</Project>
