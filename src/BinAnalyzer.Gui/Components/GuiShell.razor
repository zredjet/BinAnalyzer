@inject GuiSession Session
@inject IJSRuntime JS
@implements IDisposable

<div class="win gui-root">
    <TitleBar />
    <div class="body">
        <NavRail />
        <main class="work">
            @if (Session.Message is not null)
            {
                <div class="msgbar" role="status">@Session.Message <button class="btn" @onclick="() => Session.SetMessage(null)">閉じる</button></div>
            }
            @if (Session.Active is null || Session.ShowPicker)
            {
                <FilePicker />
            }
            else
            {
                <CommandBar Document="Session.Active" />
                <BreadcrumbBar Document="Session.Active" />
                <HexView Document="Session.Active" />
                <InfoBar Document="Session.Active" />
            }
        </main>
        @if (Session.Active is not null)
        {
            <RightPane Document="Session.Active" />
        }
    </div>
    <footer>
        @if (Session.Active is not null)
        {
            <StructureMapView Document="Session.Active" />
        }
        <StatusBar Document="Session.Active" />
    </footer>
    <HighlightStyle />
</div>

@code {
    private DotNetObjectReference<GuiShell>? _self;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        await Session.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("binGui.registerShortcuts", _self);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // JS が使えない環境（プリレンダリング等）ではショートカット無し
        }
    }

    /// <summary>gui.js から呼ばれるキーボードショートカット（Ctrl+Z / Ctrl+Y / Ctrl+S）。</summary>
    [JSInvokable]
    public async Task OnShortcut(string name)
    {
        switch (name)
        {
            case "undo": Session.Undo(); break;
            case "redo": Session.Redo(); break;
            case "save":
                if (Session.Active is { IsDirty: true } doc) await Session.SaveAsync(doc);
                break;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        if (_self is not null)
        {
            try { _ = JS.InvokeVoidAsync("binGui.unregisterShortcuts"); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
            _self.Dispose();
            _self = null;
        }
    }
}
