@inject IJSRuntime JS
@inject GuiSession Session

<div class="pane-view">
    <div class="defbar">
        <span>@_shownFile</span><span class="grow"></span>
        @if (_shownIsImport)
        {
            <span class="hint">インポート定義: @Document.Format.File から参照</span>
        }
        else if (_location is null && _diagTarget is null && Document.Selected is not null)
        {
            <span class="hint">この構造体は本ファイル内に見つかりません（インポート定義の可能性）</span>
        }
    </div>
    @if (Document.Format.Validation.Diagnostics.Count > 0)
    {
        <DefinitionDiagnostics Diagnostics="Document.Format.Validation.Diagnostics" Open="Session.DefinitionDiagnosticsOpen"
                               OnToggle="Session.ToggleDefinitionDiagnostics" OnSelect="SelectDiagnosticAsync" Current="_diagTarget" />
    }
    <pre class="yaml">@for (var i = 0; i < _lines.Length; i++)
    {
        var current = i == _location?.FieldLine || i == _diagLine;
        var cls = current ? "line cur" : i == _location?.StructLine ? "line cur-struct" : "line";
        _markers.TryGetValue(i, out var marker);
        if (marker is not null) cls += marker.IsError ? " diag-err" : " diag-warn";
        <span class="@cls" id="@(current ? "yaml-cur" : null)" title="@marker?.Title">@foreach (var t in YamlHighlighter.Tokenize(_lines[i]))
            {<span class="@TokenClass(t.Kind)">@t.Text</span>}
</span>
    }</pre>
</div>

@code {
    [Parameter, EditorRequired] public GuiDocument Document { get; set; } = null!;

    private string[] _lines = [];
    private string _shownFile = "";
    private bool _shownIsImport;
    private YamlLocation? _location;
    private int _locatedFor = -2;
    private FormatDocument? _locatedIn;

    /// <summary>インポート先ファイルの YAML テキスト（SourceFile → テキスト）。取得できなかったものは null。</summary>
    private readonly Dictionary<string, string?> _sources = new(StringComparer.Ordinal);

    /// <summary>診断の一覧から選んだ診断（REQ-185）。ノードを選び直すか定義が変わると null に戻り、選択ノードの定義行を表示する。</summary>
    private ValidationDiagnostic? _diagTarget;
    /// <summary>選んだ診断の行（0 始まり）。</summary>
    private int? _diagLine;
    /// <summary>表示中のファイルの識別子（本ファイルならルート struct の SourceFile。文字列から読んだ定義では null）。</summary>
    private string? _shownSource;
    /// <summary>表示中のファイルで診断がある行（0 始まり） → 印。</summary>
    private Dictionary<int, LineMarker> _markers = [];

    private sealed record LineMarker(bool IsError, string Title);

    protected override async Task OnParametersSetAsync()
    {
        if (_locatedFor == Document.SelectedId && ReferenceEquals(_locatedIn, Document.Format)) return;
        _locatedFor = Document.SelectedId;
        _locatedIn = Document.Format;
        _diagTarget = null;
        await LocateAsync();
    }

    /// <summary>ルート struct の SourceFile。表示中のファイルが本ファイルかどうかの判定に使う。</summary>
    private string? MainSourceFile =>
        Document.Format.Definition.Structs.TryGetValue(Document.Format.Definition.RootStruct, out var rootDef) ? rootDef.SourceFile : null;

    /// <summary>診断の一覧から選んだ診断の定義行を表示する（インポート先ならそのファイル）。</summary>
    private async Task SelectDiagnosticAsync(ValidationDiagnostic diagnostic)
    {
        if (diagnostic.SourceLine is not { } line) return;
        _diagTarget = diagnostic;
        var mainFile = MainSourceFile;
        var isImport = diagnostic.SourceFile is not null && mainFile is not null
            && !string.Equals(diagnostic.SourceFile, mainFile, StringComparison.Ordinal);
        var text = isImport ? await ReadSourceAsync(diagnostic.SourceFile!) : null;
        if (isImport && text is not null)
        {
            Show(text, Path.GetFileName(diagnostic.SourceFile!), isImport: true, source: diagnostic.SourceFile);
            _diagLine = line - 1;
        }
        else
        {
            Show(Document.Format.YamlText, Document.Format.File, isImport: false, source: mainFile);
            _diagLine = isImport ? null : line - 1; // インポート先を取得できなければ行は示さない
        }
        _location = null;
    }

    private void Show(string yaml, string shownFile, bool isImport, string? source)
    {
        _lines = yaml.Replace("\r\n", "\n").Split('\n');
        _shownFile = shownFile;
        _shownIsImport = isImport;
        _shownSource = source;
        _markers = BuildMarkers(source);
    }

    /// <summary>表示中のファイル（<paramref name="source"/>）にある診断の行と印。SourceFile が null の診断は本ファイルとみなす。</summary>
    private Dictionary<int, LineMarker> BuildMarkers(string? source)
    {
        var mainFile = MainSourceFile;
        var markers = new Dictionary<int, LineMarker>();
        foreach (var group in Document.Format.Validation.Diagnostics
                     .Where(d => d.SourceLine is not null && string.Equals(d.SourceFile ?? mainFile, source, StringComparison.Ordinal))
                     .GroupBy(d => d.SourceLine!.Value - 1))
        {
            markers[group.Key] = new LineMarker(
                group.Any(d => d.Severity == DiagnosticSeverity.Error),
                string.Join("\n", group.Select(d => $"{d.Code}: {d.Message}")));
        }
        return markers;
    }

    /// <summary>
    /// 選択ノードの定義行を決める。IR の <c>SourceLine</c>（REQ-172、パーサーが記録した行）を優先し、
    /// 無ければ <see cref="YamlFieldLocator"/> のテキスト探索にフォールバックする。
    /// 定義がインポート先ファイルにある場合はそのファイルのテキストをカタログから取得して表示する。
    /// </summary>
    private async Task LocateAsync()
    {
        var (structDef, fieldDef, structName, fieldName) = ResolveDefinition();

        var sourceFile = fieldDef?.SourceFile ?? structDef?.SourceFile;
        var mainFile = MainSourceFile;
        var isImport = sourceFile is not null && mainFile is not null && !string.Equals(sourceFile, mainFile, StringComparison.Ordinal);

        string yaml = Document.Format.YamlText;
        var shownFile = Document.Format.File;
        if (isImport)
        {
            var text = await ReadSourceAsync(sourceFile!);
            if (text is not null)
            {
                yaml = text;
                shownFile = Path.GetFileName(sourceFile!);
            }
            else
            {
                isImport = false; // 取得できなければ本ファイルを表示（探索は失敗して null になる）
            }
        }
        Show(yaml, shownFile, isImport, isImport ? sourceFile : mainFile);
        _diagLine = null;

        // パーサーの行番号（1 始まり）→ 0 始まり
        if (structDef?.SourceLine is { } structLine && (fieldDef is null || fieldDef.SourceLine is not null))
        {
            _location = new YamlLocation(structLine - 1, fieldDef?.SourceLine is { } fl ? fl - 1 : null);
            return;
        }
        _location = fieldName is null
            ? YamlFieldLocator.Locate(yaml, structName, null)
            : YamlFieldLocator.Locate(yaml, structName, fieldName);
    }

    /// <summary>選択ノードに対応する struct 定義と（配列要素なら親配列の）フィールド定義。</summary>
    private (StructDefinition? Struct, FieldDefinition? Field, string StructName, string? FieldName) ResolveDefinition()
    {
        var definition = Document.Format.Definition;
        var node = Document.Selected;
        if (node is null)
        {
            definition.Structs.TryGetValue(definition.RootStruct, out var root);
            return (root, null, definition.RootStruct, null);
        }
        var id = Document.Index.IdOf(node);
        // フィールドは最寄りの祖先 struct のブロック内で定義されている。配列要素は親配列のフィールド定義を指す。
        var fieldNode = node;
        var fieldId = id;
        if (Document.Index.ElementIndexOf(id) is not null)
        {
            fieldId = Document.Index.ParentIdOf(id);
            fieldNode = Document.Index.ById(fieldId);
        }
        var structName = definition.RootStruct;
        for (var p = Document.Index.ParentIdOf(fieldId); p >= 0; p = Document.Index.ParentIdOf(p))
        {
            if (Document.Index.ById(p) is DecodedStruct ps)
            {
                structName = ps.StructType;
                break;
            }
        }
        definition.Structs.TryGetValue(structName, out var structDef);
        if (fieldId == 0)
        {
            definition.Structs.TryGetValue(definition.RootStruct, out var rootDef);
            return (rootDef, null, structName, null);
        }
        FieldDefinition? fieldDef = null;
        if (structDef is not null)
        {
            foreach (var f in structDef.Fields)
            {
                if (f.Name == fieldNode.Name)
                {
                    fieldDef = f;
                    break;
                }
            }
        }
        return (structDef, fieldDef, structName, fieldNode.Name);
    }

    private async Task<string?> ReadSourceAsync(string sourceFile)
    {
        if (_sources.TryGetValue(sourceFile, out var cached))
            return cached;
        string? text;
        try
        {
            text = await Session.Catalog.ReadSourceAsync(sourceFile);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or HttpRequestException)
        {
            text = null;
        }
        _sources[sourceFile] = text;
        return text;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_location?.FieldLine is null && _diagLine is null) return;
        try { await JS.InvokeVoidAsync("binGui.scrollIntoView", "yaml-cur"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private static string TokenClass(YamlTokenKind kind) => kind switch
    {
        YamlTokenKind.Key => "k",
        YamlTokenKind.String => "s",
        YamlTokenKind.Number => "n",
        YamlTokenKind.Comment => "c",
        YamlTokenKind.Punct => "p",
        _ => "",
    };
}
