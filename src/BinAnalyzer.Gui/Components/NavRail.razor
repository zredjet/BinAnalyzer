@inherits SessionAwareComponent

<nav class="navview" aria-label="メイン">
    <button class="nav" aria-current="@(Session.ShowPicker ? "page" : null)" title="ファイルを開く" @onclick="Session.RequestPicker">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4" /></svg>
    </button>
    <button class="nav" aria-current="@(Current(PaneKind.Structure))" title="構造" @onclick="() => Session.SetPane(PaneKind.Structure)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="6" height="5" rx="1" /><rect x="13" y="10" width="8" height="5" rx="1" /><rect x="13" y="17" width="8" height="4" rx="1" /><path d="M6 9v10h7M6 12h7" /></svg>
    </button>
    <button class="nav" aria-current="@(Current(PaneKind.Definition))" title="フォーマット定義（@Session.Formats.Count 種）" @onclick="() => Session.SetPane(PaneKind.Definition)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z" /><path d="M4 19a2 2 0 0 0 2 2h12" /><path d="M9 7h6" /></svg>
        @if (Session.Formats.Count > 0)
        {
            <span class="badge">@Session.Formats.Count</span>
        }
    </button>
    <button class="nav" aria-current="@(Current(PaneKind.Diff))" title="差分" disabled="@(Session.Diff is null)" @onclick="() => Session.SetPane(PaneKind.Diff)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="7" height="16" rx="1.5" /><rect x="14" y="4" width="7" height="16" rx="1.5" /><path d="M5 9h3M5 13h3M16 9h3M16 15h3" /></svg>
    </button>
    <div class="spacer"></div>
</nav>

@code {
    private string? Current(PaneKind pane) => !Session.ShowPicker && Session.Active is not null && Session.Pane == pane ? "page" : null;
}
